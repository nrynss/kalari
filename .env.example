# Kalari's keys. Names only: never put a value in this file or any committed file.
# Each key can come from the environment or from the system keyring (secret-tool).

# Vultr Serverless Inference: the coding model, Clef and the embeddings
# (https://api.vultrinference.com/v1). Keyring: service vultr-inference
VULTR_INFERENCE_API_KEY=

# Vultr account API, for deploy/ only (vultr-cli reads this name). Never on the VM.
# Keyring: service vultr-api
VULTR_API_KEY=
