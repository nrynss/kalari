---
// Same-site docs link that respects the build base (/kalari or /docs).
interface Props {
  to: string;
}
const { to } = Astro.props;
const base = import.meta.env.BASE_URL;
const root = base.replace(/\/$/, '');
const target = to.replace(/^\/+/, '');
---

<a href={`${root}/${target}`}><slot /></a>
