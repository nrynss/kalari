# Lambo 0.9.0 configuration for the Kalari demo deployment.
# Installs at /etc/kalari/lambo.toml (0600, kalari:kalari). The key itself is
# never written here: api_key_env names the environment variable that
# kalari.service supplies from /etc/kalari/kalari.env.

promotion_policy = "Solo"

[store]
kind = "sqlite"
path = "/var/lib/kalari/lambo.db"

[embedder]
kind = "openai"
url = "https://api.vultrinference.com"
model = "qwen3-embedding-4b"
dim = 2560
api_key_env = "VULTR_INFERENCE_API_KEY"

[daemon]
gc_interval = 1

[serve]
default_session = "kalari"
