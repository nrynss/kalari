[Unit]
Description=Kalari MCP service (stdio endpoint with its Lambo child)
After=network.target

[Service]
Type=simple
User=kalari
Group=kalari
# Microsandbox refuses group-writable storage; the unit must not run under
# Ubuntu's default 0002 umask.
UMask=0022
EnvironmentFile=/etc/kalari/kalari.env
# kalari serve speaks MCP over stdio, so there is no socket peer under
# systemd. stdin is held open so the process supervises its Lambo child
# instead of exiting on EOF; agents reach it through a local OpenCode run.
ExecStart=/bin/sh -c 'exec /usr/bin/sleep infinity | exec /opt/kalari/bin/kalari serve /etc/kalari/kalari.json /etc/kalari/session.json'
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
