[Unit]
Description=Kalari read-only evidence API on loopback (behind Caddy)
After=network.target

[Service]
Type=simple
User=kalari
Group=kalari
UMask=0022
# No key: this endpoint only re-reads the evidence store per request.
ExecStart=/usr/bin/python3 /opt/kalari/bin/kalari-api.py --store /var/lib/kalari/evidence/.kalari/evidence.jsonl --host 127.0.0.1 --port 18001
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
