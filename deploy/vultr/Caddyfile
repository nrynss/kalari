# Caddyfile for the Kalari demo at kalari.nryn.dev.
#
# Caddy terminates TLS (automatic HTTPS, ports 80 and 443) in front of two
# loopback services: the primary site's static root for web/site/, and the
# read-only evidence API (deploy/vultr/kalari-api.py) for /api.
#
# Installs at /etc/caddy/Caddyfile. The old kalai.nryn.dev name is kept as a
# permanent redirect to the primary name. The admin
# endpoint stays on loopback (the packaged unit reloads through it), and
# neither the firewall group nor the host filter exposes it.
kalari.nryn.dev {
	root * /srv/kalari/www
	encode gzip

	handle /api/* {
		reverse_proxy 127.0.0.1:18001
	}

	handle {
		file_server
	}
}

kalai.nryn.dev {
	redir https://kalari.nryn.dev{uri} permanent
}
